# ===== frontend/.env.example — copy values into frontend/.env (gitignored) =====
# NEVER commit real secrets. This file is a template only.

# Next.js
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Auth secret (generate: openssl rand -hex 32 or node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BETTER_AUTH_SECRET=

# Neon PostgreSQL (same DATABASE_URL as backend)
DATABASE_URL=

# NOTE: RESEND_API_KEY and EMAIL_FROM live ONLY in backend/.env.
# Email is sent server-side by the FastAPI backend — a NEXT_PUBLIC_ email key
# would be exposed in the browser bundle.
