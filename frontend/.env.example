# ===== frontend/.env.example — copy values into frontend/.env (gitignored) =====
# NEVER commit real secrets. This file is a template only.

# Next.js
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Stripe (publishable key is safe for the browser bundle; the secret key
# and webhook secret live ONLY in backend/.env)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Auth secret (generate: openssl rand -hex 32 or node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BETTER_AUTH_SECRET=

# Neon PostgreSQL (same DATABASE_URL as backend)
DATABASE_URL=

# NOTE: RESEND_API_KEY and EMAIL_FROM live ONLY in backend/.env.
# Email is sent server-side by the FastAPI backend — a NEXT_PUBLIC_ email key
# would be exposed in the browser bundle.

# ===== AI Voice Agent (Vapi) =====
# Browser-safe PUBLIC key from the Vapi dashboard. Private keys stay server-side.
# When unset, the floating assistant button shows a "coming soon" notice
# instead of attempting a call that would fail.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=

# Optional: production-ready prompt management — reference a server-managed
# Vapi assistant by ID instead of the inline transient definition.
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
